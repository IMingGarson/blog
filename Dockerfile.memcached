FROM memcached:1.6-alpine
RUN apk add --no-cache cyrus-sasl cyrus-sasl-plain && \
    mkdir -p /etc/sasl2 && \
    echo 'mech_list: plain' > /etc/sasl2/memcached.conf && \
    echo 'sasldb_path: /etc/sasl2/memcached-sasldb2' >> /etc/sasl2/memcached.conf && \
    chown -R memcache:memcache /etc/sasl2